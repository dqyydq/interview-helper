# Application
INTERVIEW_HELPER_ENVIRONMENT=local
INTERVIEW_HELPER_APP_NAME=Interview Helper API
INTERVIEW_HELPER_APP_VERSION=0.1.0
INTERVIEW_HELPER_API_PREFIX=/api
INTERVIEW_HELPER_FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL
POSTGRES_DB=interview_helper
POSTGRES_USER=interview_helper
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
INTERVIEW_HELPER_DATABASE_URL=postgresql+asyncpg://interview_helper:local-development-only@localhost:5432/interview_helper
INTERVIEW_HELPER_TEST_DATABASE_URL=postgresql+asyncpg://interview_helper:local-development-only@localhost:5432/interview_helper_test
INTERVIEW_HELPER_DATABASE_CONNECT_TIMEOUT_SECONDS=2
INTERVIEW_HELPER_ENCRYPTION_SECRET=replace-with-a-random-local-secret

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
