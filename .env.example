# Application
INTERVIEW_HELPER_ENVIRONMENT=local
INTERVIEW_HELPER_APP_NAME=Interview Helper API
INTERVIEW_HELPER_APP_VERSION=0.1.0
INTERVIEW_HELPER_LOG_LEVEL=INFO
INTERVIEW_HELPER_API_PREFIX=/api
INTERVIEW_HELPER_FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL
POSTGRES_DB=interview_helper
POSTGRES_USER=interview_helper
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
INTERVIEW_HELPER_DATABASE_URL=postgresql+asyncpg://interview_helper:local-development-only@127.0.0.1:5432/interview_helper
INTERVIEW_HELPER_TEST_DATABASE_URL=postgresql+asyncpg://interview_helper:local-development-only@127.0.0.1:5432/interview_helper_test
INTERVIEW_HELPER_DATABASE_CONNECT_TIMEOUT_SECONDS=2
INTERVIEW_HELPER_ENCRYPTION_SECRET=replace-with-a-random-local-secret
INTERVIEW_HELPER_UPLOAD_DIR=./data/uploads
INTERVIEW_HELPER_RESUME_UPLOAD_MAX_BYTES=5242880
INTERVIEW_HELPER_AUDIO_UPLOAD_MAX_BYTES=15728640
INTERVIEW_HELPER_RESUME_PARSE_TIMEOUT_SECONDS=20
INTERVIEW_HELPER_WEBSOCKET_CONNECTIONS_PER_MINUTE=12
INTERVIEW_HELPER_WEBSOCKET_RATE_LIMITER_MAX_KEYS=4096
INTERVIEW_HELPER_WORKER_HEARTBEAT_INTERVAL_SECONDS=2
INTERVIEW_HELPER_WORKER_HEARTBEAT_STALE_AFTER_SECONDS=15

# Question discovery (Tavily / Firecrawl keys are configured in Settings, never committed here)
INTERVIEW_HELPER_DISCOVERY_ALLOW_HTTP_LOCAL=false
INTERVIEW_HELPER_DISCOVERY_REQUEST_TIMEOUT_SECONDS=15
INTERVIEW_HELPER_DISCOVERY_RUN_TIMEOUT_SECONDS=60
INTERVIEW_HELPER_DISCOVERY_MAX_URLS=5
INTERVIEW_HELPER_DISCOVERY_MAX_SEARCH_RESULTS=20
INTERVIEW_HELPER_DISCOVERY_MAX_SOURCES=12
INTERVIEW_HELPER_DISCOVERY_MAX_RESPONSE_BYTES=1048576
INTERVIEW_HELPER_DISCOVERY_MAX_SOURCE_CHARACTERS=16384
INTERVIEW_HELPER_DISCOVERY_MAX_EXCERPT_CHARACTERS=1200
INTERVIEW_HELPER_DISCOVERY_MAX_TOTAL_EXCERPT_CHARACTERS=8000
INTERVIEW_HELPER_DISCOVERY_RESEARCHER_INPUT_TOKENS=6000
INTERVIEW_HELPER_DISCOVERY_RESEARCHER_OUTPUT_TOKENS=2048
INTERVIEW_HELPER_DISCOVERY_MAX_CANDIDATES=20
INTERVIEW_HELPER_DISCOVERY_MAX_CONCURRENT_RUNS_PER_PROFILE=4
INTERVIEW_HELPER_DISCOVERY_RETENTION_DAYS=30
INTERVIEW_HELPER_DISCOVERY_CLEANUP_INTERVAL_SECONDS=3600

# Optional Docker-only local AI
# These loopback ports are used only after you explicitly install a verified
# preset and start one of the local Docker Compose profiles. A normal app start
# never downloads a model or starts a local AI container. See docs/local-ai.md.
INTERVIEW_HELPER_LOCAL_AI_IMPORT_DIR=./data/local-ai-import
INTERVIEW_HELPER_LOCAL_AI_DOCKER_DIAGNOSTICS_TIMEOUT_SECONDS=2
INTERVIEW_HELPER_LOCAL_AI_DOCKER_DIAGNOSTICS_CACHE_SECONDS=5
INTERVIEW_HELPER_LOCAL_AI_SERVICE_PROBE_CACHE_SECONDS=3
INTERVIEW_HELPER_LOCAL_ASR_PORT=8011
INTERVIEW_HELPER_LOCAL_ASR_MAX_AUDIO_BYTES=33554432
INTERVIEW_HELPER_LOCAL_ASR_MAX_AUDIO_SECONDS=90
INTERVIEW_HELPER_LOCAL_ASR_MAX_CONCURRENT_REQUESTS=1
INTERVIEW_HELPER_LOCAL_ASR_REQUEST_TIMEOUT_SECONDS=150
INTERVIEW_HELPER_LOCAL_EMBEDDINGS_PORT=8081
INTERVIEW_HELPER_SEMANTIC_RETRIEVAL_STATEMENT_TIMEOUT_MS=120

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
